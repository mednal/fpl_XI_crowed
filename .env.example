# Supabase — from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the viewer cookie that decides whose team an entry is. Any long random
# string; changing it makes every viewer look new. Optional in development —
# the service role key is used instead — but set it before deploying, so that
# rotating the Supabase key does not sign every viewer out.
VOTER_SECRET=a-long-random-string
